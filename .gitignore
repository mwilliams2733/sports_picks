__pycache__/
*.pyc
.venv/
# Any sibling virtualenv, e.g. a .venv-ci/ built to run the suite on the
# 3.12 the Dockerfile serves while .venv/ holds 3.14.
.venv*/
node_modules/
dist/
*.db
*.db-shm
*.db-wal
# Database backups taken before a migration or repair. `*.db` does not match
# these -- the suffix comes after the extension -- so a `git add -A` would
# otherwise stage a 6 MB binary holding every pick and user row.
*.db.bak-*
# Rotated and hand-preserved scheduler logs. These have held an Odds API key
# in a request URL; see backend/collectors/odds_api.install_log_redaction.
*.log
*.log.*
.env
config.yaml
.superpowers/
.claude/settings.local.json
uvicorn.log
*.egg-info/
codebase_export.txt
digest_preview.html

# scheduler runtime logs (rotated by scripts/start_scheduler.ps1)
scheduler.log
scheduler.out.log
scheduler*.prev
