# The Odds API key used to fetch odds/props. Pipeline runs are skipped
# (gracefully) when unset.
ODDS_API_KEY=your_odds_api_key_here

# Set to "1" to run the APScheduler cron jobs (morning scout, retries,
# recalibration) inside the FastAPI process. Default: off, so local/dev
# and test runs don't spin up background cron threads.
ENABLE_SCHEDULER=0

# Path to the sport-config YAML (season windows, odds budget, etc).
CONFIG_PATH=config.yaml

# Path to the SQLite database file.
DATABASE_PATH=sports_picks.db

# Comma-separated list of allowed CORS origins for the API. Defaults to
# the local Vite dev server origins if unset.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port uvicorn binds to. Only read by the Dockerfile's shell CMD
# (uvicorn ... --port ${PORT:-8000}), not by the Python app directly.
PORT=8000

# Resend API key for the daily picks digest (backend/digest/sender.py)
RESEND_API_KEY=your_resend_api_key_here
